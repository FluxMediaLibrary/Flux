<?xml version="1.0" encoding="utf-8" ?>
<component name="SeasonScreen" extends="Group" initialFocus="episodes">
  <interface>
    <field id="mediaId" type="string" />
    <field id="showTitle" type="string" onChange="renderHeader" />
    <field id="season" type="integer" onChange="renderHeader" />
    <field id="episodesData" type="array" onChange="renderEpisodes" />
    <field id="episodeSelected" type="assocarray" alwaysNotify="true" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
    <field id="focusIndex" type="array" onChange="restoreFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SeasonScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <FluxTopBar id="topbar" />
    <Label id="eyebrow" width="1200" height="30" translation="[96,164]" color="#60A5FA" />
    <Label id="header" width="1600" height="64" translation="[96,196]" color="#F4F4F5" />
    <Label id="summary" width="1600" height="32" translation="[96,266]" color="#7D8189" />
    <MarkupGrid id="episodes" translation="[96,330]" itemComponentName="EpisodeCard" numColumns="4" numRows="2" itemSize="[392,300]" itemSpacing="[53,26]" drawFocusFeedback="false" />
    <Group id="emptyState" visible="false" translation="[96,360]">
      <Label id="emptyTitle" width="1400" height="50" text="No episodes in this season yet" color="#F4F4F5" />
      <Label id="emptyBody" width="1400" height="40" text="Episodes appear here as soon as they are added to the library." color="#B4B6BC" translation="[0,54]" />
      <MarkupList id="emptyActions" translation="[0,120]" itemComponentName="FluxButton" itemSize="[260,64]" numRows="1" drawFocusFeedback="false" />
    </Group>
  </children>
</component>
