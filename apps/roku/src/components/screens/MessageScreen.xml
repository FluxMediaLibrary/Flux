<?xml version="1.0" encoding="utf-8" ?>
<!-- Centred dialog for errors, confirmations and long text (diagnostics, release notes). -->
<component name="MessageScreen" extends="Group" initialFocus="actionsList">
  <interface>
    <field id="title" type="string" onChange="render" />
    <field id="message" type="string" onChange="render" />
    <field id="actions" type="array" onChange="renderActions" />
    <field id="actionSelected" type="integer" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/MessageScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <Group id="card" translation="[460,200]">
      <Poster uri="pkg:/images/card-lg.9.png" width="1000" height="680" blendColor="#171A1F" />
      <Poster uri="pkg:/images/logo.png" width="40" height="40" translation="[56,52]" loadDisplayMode="scaleToFit" />
      <Label id="titleLabel" width="880" height="120" translation="[56,108]" wrap="true" maxLines="2" color="#F4F4F5" />
      <Label id="messageLabel" width="880" height="300" translation="[56,236]" wrap="true" maxLines="9" color="#B4B6BC" />
      <MarkupGrid id="actionsList" translation="[56,560]" itemComponentName="FluxButton" itemSize="[880,64]" itemSpacing="[12,12]" numColumns="1" numRows="3" drawFocusFeedback="false" />
    </Group>
  </children>
</component>
