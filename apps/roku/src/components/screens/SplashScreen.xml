<?xml version="1.0" encoding="utf-8" ?>
<component name="SplashScreen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/screens/SplashScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <Poster uri="pkg:/images/logo.png" width="120" height="120" translation="[900,380]" loadDisplayMode="scaleToFit" />
    <Label id="wordmark" text="Flux" width="1920" height="70" translation="[0,520]" horizAlign="center" color="#F4F4F5" />
    <Label id="tagline" text="Connecting to your library" width="1920" height="36" translation="[0,596]" horizAlign="center" color="#7D8189" />
    <Rectangle width="320" height="4" translation="[800,660]" color="#21262D" />
    <Rectangle id="bar" width="96" height="4" translation="[800,660]" color="#3B82F6" />
    <Animation id="barAnimation" duration="1.4" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[800, 660], [1024, 660]]" fieldToInterp="bar.translation" />
    </Animation>
  </children>
</component>
