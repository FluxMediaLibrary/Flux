<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group" initialFocus="inputCapture">
  <interface>
    <field id="playbackData" type="assocarray" onChange="startPlayback" />
    <field id="progressEvent" type="assocarray" alwaysNotify="true" />
    <field id="stopped" type="assocarray" alwaysNotify="true" />
    <field id="nextRequested" type="assocarray" alwaysNotify="true" />
    <field id="audioTrackSelected" type="assocarray" alwaysNotify="true" />
    <field id="subtitleTrackSelected" type="assocarray" alwaysNotify="true" />
    <field id="qualitySelected" type="assocarray" alwaysNotify="true" />
    <field id="qualityPreference" type="integer" value="20000000" onChange="renderQualityOptions" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <Group id="inputCapture" focusable="true" />
    <Rectangle width="1920" height="1080" color="#000000" />
    <Video id="video" width="1920" height="1080" enableUI="false" />

    <!-- Buffering: small pill, top-left, never covers the picture. -->
    <Group id="bufferingOverlay" visible="false" translation="[96,60]">
      <Poster uri="pkg:/images/pill.9.png" width="300" height="60" blendColor="#0D0F12" opacity="0.85" />
      <BusySpinner id="bufferingSpinner" translation="[16,10]" uri="pkg:/images/spinner.png" visible="false" />
      <Label id="bufferingLabel" text="Buffering…" width="220" height="60" translation="[70,0]" vertAlign="center" color="#F4F4F5" />
    </Group>

    <!-- Skip intro / Up next sit above the transport bar, bottom-right. -->
    <Group id="skipIntro" visible="false" translation="[1544,760]">
      <Poster uri="pkg:/images/pill.9.png" width="280" height="64" blendColor="#F4F4F5" opacity="0.95" />
      <Label id="skipIntroLabel" text="Skip intro   ·   OK" width="280" height="64" horizAlign="center" vertAlign="center" color="#0D0F12" />
    </Group>
    <Group id="upNext" visible="false" translation="[1304,700]">
      <Poster uri="pkg:/images/card-lg.9.png" width="520" height="132" blendColor="#0D0F12" opacity="0.92" />
      <Label id="upNextEyebrow" text="UP NEXT   ·   press OK" width="472" height="26" translation="[24,18]" color="#60A5FA" />
      <Label id="nextTitle" width="472" height="40" translation="[24,48]" color="#F4F4F5" />
      <Label id="nextSubtitle" width="472" height="30" translation="[24,88]" color="#B4B6BC" />
    </Group>

    <!-- Right-hand option panels. -->
    <Group id="playbackMenu" visible="false" translation="[1264,120]">
      <Poster uri="pkg:/images/card-lg.9.png" width="560" height="320" blendColor="#0D0F12" opacity="0.94" />
      <Label id="playbackMenuTitle" text="Playback options" width="500" height="40" translation="[30,26]" color="#F4F4F5" />
      <MarkupList id="playbackOptions" translation="[30,82]" itemComponentName="FluxListItem" itemSize="[500,64]" itemSpacing="[0,6]" numRows="3" drawFocusFeedback="false" />
    </Group>
    <Group id="audioOverlay" visible="false" translation="[1264,120]">
      <Poster uri="pkg:/images/card-lg.9.png" width="560" height="480" blendColor="#0D0F12" opacity="0.94" />
      <Label id="audioTitle" text="Audio track" width="500" height="40" translation="[30,26]" color="#F4F4F5" />
      <MarkupList id="audioTracks" translation="[30,82]" itemComponentName="FluxListItem" itemSize="[500,64]" itemSpacing="[0,6]" numRows="5" drawFocusFeedback="false" />
    </Group>
    <Group id="subtitleOverlay" visible="false" translation="[1264,120]">
      <Poster uri="pkg:/images/card-lg.9.png" width="560" height="480" blendColor="#0D0F12" opacity="0.94" />
      <Label id="subtitleTitle" text="Captions" width="500" height="40" translation="[30,26]" color="#F4F4F5" />
      <MarkupList id="subtitleTracks" translation="[30,82]" itemComponentName="FluxListItem" itemSize="[500,64]" itemSpacing="[0,6]" numRows="5" drawFocusFeedback="false" />
    </Group>
    <Group id="qualityOverlay" visible="false" translation="[1264,120]">
      <Poster uri="pkg:/images/card-lg.9.png" width="560" height="400" blendColor="#0D0F12" opacity="0.94" />
      <Label id="qualityTitle" text="Stream quality" width="500" height="40" translation="[30,26]" color="#F4F4F5" />
      <MarkupList id="qualityOptions" translation="[30,82]" itemComponentName="FluxListItem" itemSize="[500,64]" itemSpacing="[0,6]" numRows="4" drawFocusFeedback="false" />
    </Group>

    <Group id="exitControls" visible="false" translation="[96,700]">
      <Poster uri="pkg:/images/pill.9.png" width="400" height="60" blendColor="#0D0F12" opacity="0.88" />
      <Label id="exitLabel" text="Press Back again to stop" width="400" height="60" horizAlign="center" vertAlign="center" color="#F4F4F5" />
    </Group>

    <!-- Transport: gradient scrim, title, seek bar, times, hint. -->
    <Group id="transportOverlay" visible="false">
      <Poster uri="pkg:/images/scrim-player.png" width="1920" height="320" translation="[0,760]" loadDisplayMode="scaleToFill" />
      <Label id="playTitle" width="1400" height="44" translation="[96,846]" color="#F4F4F5" />
      <Label id="playSubtitle" width="1400" height="30" translation="[96,890]" color="#B4B6BC" />
      <Rectangle id="seekTrack" width="1728" height="6" translation="[96,940]" color="#FFFFFF" opacity="0.25" />
      <Rectangle id="seekFill" width="0" height="6" translation="[96,940]" color="#3B82F6" />
      <Rectangle id="seekKnob" width="18" height="18" translation="[87,934]" color="#F4F4F5" />
      <Label id="currentTime" width="300" height="30" translation="[96,962]" color="#F4F4F5" />
      <Label id="transportHint" text="OK play/pause   ·   ◀ ▶ seek 10s   ·   ▼ options" width="1000" height="30" translation="[460,962]" horizAlign="center" color="#7D8189" />
      <Label id="durationTime" width="300" height="30" translation="[1524,962]" horizAlign="right" color="#F4F4F5" />
    </Group>
    <Timer id="heartbeat" duration="15" repeat="true" />
    <Timer id="exitTimer" duration="3" repeat="false" />
    <Timer id="transportTimer" duration="5" repeat="false" />
  </children>
</component>
