<?xml version="1.0" encoding="utf-8" ?>
<component name="RequestsScreen" extends="Group" initialFocus="requests">
  <interface>
    <field id="requestData" type="assocarray" onChange="renderRequests" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/RequestsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
  <children>
    <FluxBackground />
    <FluxTopBar id="topbar" />
    <Label id="titleLabel" text="Requests" width="900" height="64" translation="[96,150]" color="#F4F4F5" />
    <Label id="summary" width="1600" height="34" translation="[96,218]" color="#7D8189" />
    <MarkupList id="requests" translation="[96,282]" itemComponentName="FluxListItem" itemSize="[1728,84]" itemSpacing="[0,8]" numRows="8" drawFocusFeedback="false" />
    <Group id="emptyState" visible="false" translation="[96,300]">
      <Label id="emptyTitle" width="1400" height="50" text="No requests yet" color="#F4F4F5" />
      <Label id="emptyBody" width="1400" height="80" wrap="true" text="Request movies and series from the Flux web app or phone app. Their progress — approved, downloading, available — shows up here." color="#B4B6BC" translation="[0,54]" />
      <MarkupList id="emptyActions" translation="[0,160]" itemComponentName="FluxButton" itemSize="[240,64]" numRows="1" drawFocusFeedback="false" />
    </Group>
  </children>
</component>
