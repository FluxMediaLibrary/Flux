    <Label text="DISCOVER" width="900" height="34" translation="[944,150]" font="font:SmallBoldSystemFont" color="#6B6B6C" />
    <RowList id="resultRows" translation="[944,196]" numRows="2" rowLabelOffset="[[0,16]]" itemSize="[900,430]" rowItemSize="[[248,372]]" rowItemSpacing="[[28,0]]" itemComponentName="MediaCard" showRowLabel="[true]" focusBitmapUri="pkg:/images/focus.9.png" />
