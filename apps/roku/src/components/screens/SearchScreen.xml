    <field id="initialQuery" type="string" onChange="restoreQuery" />
    <field id="voiceQuery" type="string" onChange="applyVoiceQuery" />
    <field id="recentSearches" type="array" onChange="renderRecent" />
    <field id="recentSelected" type="string" alwaysNotify="true" />
    <field id="loading" type="boolean" onChange="renderState" />
    <field id="errorMessage" type="string" onChange="renderState" />
    <field id="queryChanged" type="string" alwaysNotify="true" />
    <field id="mediaSelected" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
