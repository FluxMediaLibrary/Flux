<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group" initialFocus="keyboard">
  <interface>
    <field id="results" type="assocarray" onChange="renderResults" />
    <field id="initialQuery" type="string" onChange="restoreQuery" />
    <field id="voiceQuery" type="string" onChange="applyVoiceQuery" />
    <field id="recentSearches" type="array" onChange="renderRecent" />
    <field id="recentSelected" type="string" alwaysNotify="true" />
    <field id="loading" type="boolean" onChange="renderState" />
    <field id="errorMessage" type="string" onChange="renderState" />
    <field id="queryChanged" type="string" alwaysNotify="true" />
    <field id="mediaSelected" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <FluxTopBar id="topbar" />
    <Group translation="[96,150]">
      <Poster uri="pkg:/images/card-lg.9.png" width="810" height="560" blendColor="#171A1F" />
      <Keyboard id="keyboard" translation="[16,24]" showTextEditBox="true" showMiniKeyboard="false" />
    </Group>
    <Label id="recentHeader" text="RECENT" width="810" height="28" translation="[96,740]" color="#7D8189" />
    <MarkupList id="recent" translation="[96,776]" itemComponentName="FluxListItem" itemSize="[810,56]" itemSpacing="[0,6]" numRows="4" drawFocusFeedback="false" />
    <Label id="hint" width="900" height="34" translation="[924,150]" color="#7D8189" />
    <RowList id="resultRows" translation="[924,196]" numRows="2" rowLabelOffset="[[0,10]]" itemSize="[900,424]" rowItemSize="[[196,360]]" rowItemSpacing="[[24,0]]" itemComponentName="RailCard" rowLabelColor="#F4F4F5" showRowLabel="[true]" drawFocusFeedback="false" rowFocusAnimationStyle="fixedFocusWrap" />
    <Timer id="debounce" duration="0.45" repeat="false" />
  </children>
</component>
