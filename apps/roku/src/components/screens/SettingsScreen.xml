<?xml version="1.0" encoding="utf-8" ?>
<!-- Two columns: categories on the left, the selected category's options on the right. -->
<component name="SettingsScreen" extends="Group" initialFocus="categories">
  <interface>
    <field id="serverName" type="string" onChange="render" />
    <field id="serverUrl" type="string" onChange="render" />
    <field id="appVersion" type="string" onChange="render" />
    <field id="preferences" type="assocarray" onChange="renderActions" />
    <field id="serverVersion" type="string" onChange="render" />
    <field id="accountLabel" type="string" onChange="render" />
    <field id="profileLabel" type="string" onChange="render" />
    <field id="initialCategory" type="string" onChange="applyInitialCategory" />
    <field id="actionSelected" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <FluxTopBar id="topbar" />
    <Label id="titleLabel" text="Settings" width="900" height="64" translation="[96,150]" color="#F4F4F5" />
    <Label id="identity" width="1000" height="34" translation="[824,166]" horizAlign="right" color="#7D8189" />
    <MarkupList id="categories" translation="[96,244]" itemComponentName="FluxListItem" itemSize="[440,64]" itemSpacing="[0,6]" numRows="8" drawFocusFeedback="false" />
    <Group translation="[584,244]">
      <Poster uri="pkg:/images/card-lg.9.png" width="1240" height="740" blendColor="#171A1F" />
      <Label id="sectionTitle" width="1160" height="40" translation="[40,36]" color="#F4F4F5" />
      <Label id="sectionHint" width="1160" height="30" translation="[40,78]" color="#7D8189" />
      <MarkupList id="actions" translation="[40,130]" itemComponentName="FluxListItem" itemSize="[1160,72]" itemSpacing="[0,6]" numRows="7" drawFocusFeedback="false" />
    </Group>
  </children>
</component>
