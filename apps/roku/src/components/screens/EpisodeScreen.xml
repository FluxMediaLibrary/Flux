<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeScreen" extends="Group" initialFocus="actions">
  <interface>
    <field id="episode" type="assocarray" onChange="renderEpisode" />
    <field id="playSelected" type="assocarray" alwaysNotify="true" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/EpisodeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <Poster id="backdrop" width="1920" height="560" opacity="0.56" loadDisplayMode="scaleToFill" />
    <Rectangle width="1920" height="560" color="#0D0F12" opacity="0.58" />
    <Rectangle width="1920" height="1" translation="[0,560]" color="#2A3447" />
    <Poster id="thumbnail" width="760" height="428" translation="[72,166]" loadDisplayMode="scaleToFill" />
    <Rectangle width="760" height="428" translation="[72,166]" color="#2A3447" opacity="0.12" />
    <Label id="showTitle" width="820" height="42" translation="[900,168]" font="font:MediumBoldSystemFont" color="#60A5FA" />
    <Label id="title" width="850" height="100" translation="[896,214]" wrap="true" maxLines="2" font="font:ExtraLargeBoldSystemFont" color="#F4F4F5" />
    <Label id="metadata" width="820" height="44" translation="[900,330]" font="font:MediumSystemFont" color="#AAA9AA" />
    <Label id="overview" width="800" height="140" translation="[900,390]" wrap="true" maxLines="4" font="font:MediumSystemFont" color="#F4F4F5" />
    <Label id="progress" width="1000" height="42" translation="[900,616]" font="font:SmallSystemFont" color="#AAA9AA" />
    <Label id="availability" text="This episode is not currently available to play." width="900" height="58" translation="[900,676]" font="font:MediumBoldSystemFont" color="#F59E0B" visible="false" />
    <MarkupGrid id="actions" translation="[72,662]" itemComponentName="FluxActionItem" itemSize="[310,62]" itemSpacing="[16,0]" numColumns="3" numRows="1" drawFocusFeedback="false" />
  </children>
</component>
