<?xml version="1.0" encoding="utf-8" ?>
<component name="LibraryScreen" extends="Group" initialFocus="items">
  <interface>
    <field id="title" type="string" onChange="renderTitle" />
    <field id="pageData" type="assocarray" onChange="renderItems" />
    <field id="mediaSelected" type="assocarray" alwaysNotify="true" />
    <field id="pageChangeRequested" type="integer" alwaysNotify="true" />
    <field id="sortRequested" type="boolean" alwaysNotify="true" />
    <field id="watchedRequested" type="boolean" alwaysNotify="true" />
    <field id="genreRequested" type="boolean" alwaysNotify="true" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
    <field id="sortLabel" type="string" onChange="renderFilters" />
    <field id="watchedLabel" type="string" onChange="renderFilters" />
    <field id="genreLabel" type="string" onChange="renderFilters" />
    <field id="focusIndex" type="integer" value="-1" onChange="restoreFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/LibraryScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <FluxTopBar id="topbar" />
    <Label id="titleLabel" width="900" height="64" translation="[96,150]" color="#F4F4F5" />
    <Label id="pageLabel" width="700" height="64" translation="[1124,150]" horizAlign="right" vertAlign="center" color="#7D8189" />
    <MarkupGrid id="filters" translation="[96,222]" itemComponentName="FluxButton" itemSize="[300,52]" itemSpacing="[12,0]" numColumns="5" numRows="1" drawFocusFeedback="false" />
    <MarkupGrid id="items" translation="[96,300]" itemComponentName="MediaCard" numColumns="7" numRows="2" itemSize="[196,360]" itemSpacing="[59,20]" drawFocusFeedback="false" />
    <Group id="emptyState" visible="false" translation="[96,340]">
      <Label id="emptyTitle" width="1400" height="50" text="Nothing matches these filters" color="#F4F4F5" />
      <Label id="emptyBody" width="1400" height="40" text="Change the sort, watched or genre filter above, or go back home." color="#B4B6BC" translation="[0,54]" />
      <MarkupList id="emptyActions" translation="[0,120]" itemComponentName="FluxButton" itemSize="[240,64]" numRows="1" drawFocusFeedback="false" />
    </Group>
  </children>
</component>
