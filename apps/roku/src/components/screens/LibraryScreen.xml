<?xml version="1.0" encoding="utf-8" ?>
<component name="LibraryScreen" extends="Group" initialFocus="items">
  <interface>
    <field id="title" type="string" onChange="renderTitle" />
    <field id="pageData" type="assocarray" onChange="renderItems" />
    <field id="mediaSelected" type="assocarray" alwaysNotify="true" />
    <field id="pageChangeRequested" type="integer" alwaysNotify="true" />
    <field id="sortRequested" type="boolean" alwaysNotify="true" />
    <field id="watchedRequested" type="boolean" alwaysNotify="true" />
    <field id="genreRequested" type="boolean" alwaysNotify="true" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
    <field id="sortLabel" type="string" onChange="renderSort" />
    <field id="watchedLabel" type="string" onChange="renderSort" />
    <field id="genreLabel" type="string" onChange="renderSort" />
    <field id="focusIndex" type="integer" value="-1" onChange="restoreFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/LibraryScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <FluxBackground />
    <Poster uri="pkg:/images/logo.png" width="48" height="48" translation="[72,40]" loadDisplayMode="scaleToFit" />
    <Label id="titleLabel" width="1200" height="65" translation="[138,39]" font="font:ExtraLargeBoldSystemFont" color="#F4F4F5" />
    <Label id="pageLabel" width="400" height="40" translation="[1436,54]" horizAlign="right" font="font:SmallSystemFont" color="#AAA9AA" />
    <Rectangle width="1776" height="88" translation="[72,130]" color="#171A1F" />
    <Label id="sortDisplay" width="1680" height="42" translation="[100,154]" font="font:MediumSystemFont" color="#AAA9AA" />
    <Label text="LIBRARY" width="400" height="34" translation="[72,254]" font="font:SmallBoldSystemFont" color="#6B6B6C" />
    <MarkupGrid id="items" translation="[72,300]" itemComponentName="MediaCard" numColumns="6" numRows="2" itemSize="[248,372]" itemSpacing="[56,38]" />
    <Label id="empty" text="No titles match these library filters." width="900" height="65" translation="[100,320]" font="font:MediumSystemFont" color="#AAA9AA" visible="false" />
    <MarkupList id="emptyActions" translation="[100,412]" itemComponentName="FluxActionItem" itemSize="[420,64]" numRows="1" drawFocusFeedback="false" visible="false" />
  </children>
</component>
