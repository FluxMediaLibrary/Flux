<?xml version="1.0" encoding="utf-8" ?>
<!--
  RowList item that picks the card shape from the row's item size: landscape
  rows (Continue Watching, episodes) render an EpisodeCard, everything else a
  poster MediaCard. Lets one RowList mix both shapes.
-->
<component name="RailCard" extends="Group">
  <interface>
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="itemContent" type="node" onChange="render" />
    <field id="focusPercent" type="float" onChange="renderFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/RailCard.brs" />
  <children>
    <MediaCard id="poster" />
    <EpisodeCard id="wide" visible="false" />
  </children>
</component>
