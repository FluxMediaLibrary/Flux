<?xml version="1.0" encoding="utf-8" ?>
<!-- Profile tile: 220x220 avatar (or initial on a coloured tile) + name. Footprint 220x290. -->
<component name="ProfileCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="render" />
    <field id="focusPercent" type="float" onChange="renderFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/ProfileCard.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <Group id="tile">
      <Poster id="tileFill" uri="pkg:/images/card-lg.9.png" width="220" height="220" blendColor="#3B82F6" />
      <Label id="initial" width="220" height="220" horizAlign="center" vertAlign="center" color="#FFFFFF" />
      <Poster id="avatar" width="220" height="220" loadDisplayMode="scaleToFill" visible="false" />
      <Poster id="focus" uri="pkg:/images/focus-ring.9.png" width="236" height="236" translation="[-8,-8]" visible="false" />
    </Group>
    <Label id="name" width="220" height="40" translation="[0,238]" horizAlign="center" color="#B4B6BC" />
  </children>
</component>
