<?xml version="1.0" encoding="utf-8" ?>
<!-- Top-bar tab: text with an accent underline when focused (matches the web navbar). -->
<component name="FluxNavItem" extends="Group">
  <interface>
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="itemContent" type="node" onChange="render" />
    <field id="focusPercent" type="float" onChange="renderFocus" />
    <field id="listHasFocus" type="boolean" onChange="renderFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxNavItem.brs" />
  <children>
    <Label id="title" vertAlign="center" horizAlign="center" color="#B4B6BC" />
    <Rectangle id="underline" height="4" color="#3B82F6" opacity="0" />
  </children>
</component>
