<?xml version="1.0" encoding="utf-8" ?>
<!--
  Poster card (196x294 artwork + title below). Total footprint 196x360.
  Badges: watched check (top-right), unplayed count (top-left), progress bar
  along the poster's bottom edge. Focus = rounded ring + slight scale.
-->
<component name="MediaCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="render" />
    <field id="focusPercent" type="float" onChange="renderFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/MediaCard.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
  <children>
    <Group id="art">
      <Poster uri="pkg:/images/card.9.png" width="196" height="294" blendColor="#171A1F" />
      <Poster id="poster" width="196" height="294" loadDisplayMode="scaleToFill" />
      <Poster uri="pkg:/images/card.9.png" width="196" height="294" blendColor="#000000" opacity="0" id="dim" />
      <Rectangle id="progressTrack" width="176" height="6" translation="[10,276]" color="#000000" opacity="0.55" visible="false" />
      <Rectangle id="progressFill" width="0" height="6" translation="[10,276]" color="#3B82F6" visible="false" />
      <Group id="watchedBadge" translation="[156,10]" visible="false">
        <Poster uri="pkg:/images/pill.9.png" width="30" height="30" blendColor="#22C55E" />
        <Poster uri="pkg:/images/icon-check.png" width="20" height="20" translation="[5,5]" blendColor="#052E16" />
      </Group>
      <Group id="countBadge" translation="[10,10]" visible="false">
        <Poster id="countPill" uri="pkg:/images/pill.9.png" width="40" height="30" blendColor="#3B82F6" />
        <Label id="countBadgeText" width="40" height="30" horizAlign="center" vertAlign="center" color="#FFFFFF" />
      </Group>
      <Poster id="focus" uri="pkg:/images/focus-ring.9.png" width="212" height="310" translation="[-8,-8]" visible="false" />
    </Group>
    <Label id="title" width="196" height="30" translation="[0,306]" color="#F4F4F5" />
    <Label id="subtitle" width="196" height="26" translation="[0,336]" color="#7D8189" />
  </children>
</component>
