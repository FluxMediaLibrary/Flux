    <Label id="titleLabel" width="520" height="210" translation="[72,188]" wrap="true" font="font:ExtraLargeBoldSystemFont" color="#F4F4F5" />
    <Label id="messageLabel" width="520" height="290" translation="[72,454]" wrap="true" font="font:MediumSystemFont" color="#AAA9AA" />
    <Label text="NEXT STEP" width="940" height="36" translation="[786,220]" font="font:SmallBoldSystemFont" color="#6B6B6C" />
    <MarkupList id="actionsList" translation="[786,278]" itemComponentName="FluxActionItem" itemSize="[900,82]" itemSpacing="[0,10]" numRows="3" drawFocusFeedback="false" />
  </children>
</component>

