    <field id="title" type="string" onChange="render" />
    <field id="message" type="string" onChange="render" />
    <field id="actions" type="array" onChange="renderActions" />
    <field id="actionSelected" type="integer" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/MessageScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/FluxTheme.brs" />
