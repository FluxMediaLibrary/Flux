<?xml version="1.0" encoding="utf-8" ?>
<component name="LibraryScreen" extends="Group" initialFocus="items">
  <interface>
    <field id="title" type="string" onChange="renderTitle" />
    <field id="pageData" type="assocarray" onChange="renderItems" />
    <field id="mediaSelected" type="assocarray" alwaysNotify="true" />
    <field id="pageChangeRequested" type="integer" alwaysNotify="true" />
    <field id="sortRequested" type="boolean" alwaysNotify="true" />
    <field id="watchedRequested" type="boolean" alwaysNotify="true" />
    <field id="genreRequested" type="boolean" alwaysNotify="true" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
    <field id="sortLabel" type="string" onChange="renderSort" />
    <field id="watchedLabel" type="string" onChange="renderSort" />
    <field id="genreLabel" type="string" onChange="renderSort" />
    <field id="focusIndex" type="integer" value="-1" onChange="restoreFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/LibraryScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="#0d0f12" />
    <Poster uri="pkg:/images/logo.png" width="70" height="70" translation="[75,50]" loadDisplayMode="scaleToFit" />
    <Label id="titleLabel" width="1350" height="70" translation="[175,54]" font="font:ExtraLargeBoldSystemFont" color="#f4f4f5" />
    <Label id="pageLabel" width="400" height="45" translation="[1430,72]" horizAlign="right" font="font:SmallSystemFont" color="#aaa9aa" />
    <Label id="sortDisplay" width="800" height="38" translation="[90,132]" font="font:SmallSystemFont" color="#aaa9aa" />
    <MarkupGrid id="items" translation="[90,180]" itemComponentName="MediaCard" numColumns="7" numRows="2" itemSize="[226,341]" itemSpacing="[28,40]" />
    <Label id="empty" text="No titles match these library filters." width="900" height="65" translation="[90,240]" font="font:MediumSystemFont" color="#aaa9aa" visible="false" />
    <LabelList id="emptyActions" translation="[90,325]" itemSize="[420,68]" numRows="1" focusBitmapUri="pkg:/images/focus.9.png" visible="false" />
  </children>
</component>
