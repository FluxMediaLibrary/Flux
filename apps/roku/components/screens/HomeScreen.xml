<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group" initialFocus="rows">
  <interface>
    <field id="homeData" type="assocarray" onChange="renderHome" />
    <field id="serverName" type="string" onChange="renderHeader" />
    <field id="requestsEnabled" type="boolean" onChange="renderNavigation" />
    <field id="homeStatus" type="string" onChange="renderStatus" />
    <field id="accentColor" type="color" value="#8b5cf6" onChange="renderBranding" />
    <field id="logoUrl" type="string" onChange="renderBranding" />
    <field id="focusIndex" type="array" onChange="restoreFocus" />
    <field id="heroRotationSeconds" type="integer" value="0" onChange="configureHeroRotation" />
    <field id="mediaSelected" type="assocarray" alwaysNotify="true" />
    <field id="heroActionSelected" type="assocarray" alwaysNotify="true" />
    <field id="destinationSelected" type="string" alwaysNotify="true" />
    <field id="rowRetryRequested" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="#0d0f12" />
    <Poster id="logo" uri="pkg:/images/logo.png" width="80" height="80" translation="[70,45]" loadDisplayMode="scaleToFit" />
    <Label id="header" width="1200" height="60" translation="[175,55]" font="font:LargeBoldSystemFont" color="#f4f4f5" />
    <Label id="status" width="550" height="45" translation="[1280,70]" horizAlign="right" font="font:SmallSystemFont" color="#f59e0b" />
    <LabelList id="navigation" translation="[70,180]" itemSize="[260,74]" numRows="7" focusBitmapUri="pkg:/images/focus.9.png" />
    <HeroBanner id="hero" translation="[370,145]" />
    <Timer id="heroTimer" repeat="true" duration="8" />
    <Label id="empty" text="Your Flux library is empty. Add media on the server, then return here to refresh." width="1320" height="90" translation="[410,520]" wrap="true" font="font:MediumSystemFont" color="#aaa9aa" visible="false" />
    <RowList id="rows" translation="[370,480]" numRows="2" rowLabelOffset="[[0,18]]" itemSize="[1480,265]" rowItemSize="[[170,255]]" rowItemSpacing="[[24,0]]" showRowLabel="[true]" focusBitmapUri="pkg:/images/focus.9.png" />
  </children>
</component>
