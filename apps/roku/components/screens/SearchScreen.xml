<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group" initialFocus="keyboard">
  <interface>
    <field id="results" type="assocarray" onChange="renderResults" />
    <field id="initialQuery" type="string" onChange="restoreQuery" />
    <field id="recentSearches" type="array" onChange="renderRecent" />
    <field id="recentSelected" type="string" alwaysNotify="true" />
    <field id="loading" type="boolean" onChange="renderState" />
    <field id="errorMessage" type="string" onChange="renderState" />
    <field id="queryChanged" type="string" alwaysNotify="true" />
    <field id="mediaSelected" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="#0d0f12" />
    <Label text="Search Flux" width="800" height="70" translation="[70,45]" font="font:ExtraLargeBoldSystemFont" color="#f4f4f5" />
    <Keyboard id="keyboard" translation="[70,145]" showTextEditBox="true" showMiniKeyboard="false" />
    <Label text="Recent searches" width="620" height="42" translation="[70,725]" font="font:MediumBoldSystemFont" color="#f4f4f5" />
    <LabelList id="recent" translation="[70,775]" itemSize="[620,48]" numRows="5" focusBitmapUri="pkg:/images/focus.9.png" />
    <Label id="hint" text="Enter at least two characters" width="1050" height="50" translation="[760,72]" font="font:SmallSystemFont" color="#aaa9aa" />
    <RowList id="resultRows" translation="[760,125]" numRows="3" rowLabelOffset="[[0,18]]" itemSize="[1080,300]" rowItemSize="[[185,278]]" rowItemSpacing="[[24,0]]" showRowLabel="[true]" focusBitmapUri="pkg:/images/focus.9.png" />
    <Timer id="debounce" duration="0.45" repeat="false" />
  </children>
</component>
