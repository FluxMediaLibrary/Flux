<?xml version="1.0" encoding="utf-8" ?>
<component name="SeasonScreen" extends="Group" initialFocus="episodes">
  <interface>
    <field id="mediaId" type="string" />
    <field id="showTitle" type="string" onChange="renderHeader" />
    <field id="season" type="integer" onChange="renderHeader" />
    <field id="episodesData" type="array" onChange="renderEpisodes" />
    <field id="episodeSelected" type="assocarray" alwaysNotify="true" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
    <field id="focusIndex" type="array" onChange="restoreFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/SeasonScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="#0d0f12" />
    <Poster uri="pkg:/images/logo.png" width="70" height="70" translation="[75,50]" loadDisplayMode="scaleToFit" />
    <Label id="header" width="1500" height="75" translation="[175,52]" font="font:ExtraLargeBoldSystemFont" color="#f4f4f5" />
    <Label id="empty" text="No episodes are available in this season." width="1300" height="70" translation="[95,225]" font="font:MediumSystemFont" color="#aaa9aa" visible="false" />
    <LabelList id="emptyActions" translation="[95,315]" itemSize="[480,68]" numRows="1" focusBitmapUri="pkg:/images/focus.9.png" visible="false" />
    <RowList id="episodes" translation="[95,180]" numRows="3" rowLabelOffset="[0,18]" itemSize="[1730,270]" rowItemSize="[[360,210]]" rowItemSpacing="[[28,0]]" showRowLabel="false" focusBitmapUri="pkg:/images/focus.9.png" />
  </children>
</component>
