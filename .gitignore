node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# Prisma
packages/backend/prisma/migrations/dev.db*

# Runtime / media data (never commit user media or torrents)
/data/
media/
transcode/
*.torrent

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
