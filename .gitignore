!.vscode/extensions.json

# Test / coverage
coverage/

# Misc
tes.js
.codex/

# Android local SDK path
android/local.properties
android/.gradle/

# Android TWA / app signing — NEVER commit these. The keystore + its password
# sign the APK; losing them means you can't ship updates, and leaking them lets
# anyone sign an app as you. Back them up somewhere private instead.
flux-release.keystore
.twa-keystore-password.txt
*.keystore
*.aab
twa/

# Android APKs in packages/frontend/public and releases/android are intentional
# self-hosted release artifacts and remain tracked.
.env.vps
