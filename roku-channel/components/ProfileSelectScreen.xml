<?xml version="1.0" encoding="utf-8"?>
<component name="ProfileSelectScreen" extends="Group">
    <interface>
        <field id="api" type="assocarray" />
        <field id="close" type="boolean" alwaysNotify="true" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/ProfileSelectScreen.brs" />
    <children>
        <Rectangle color="#0a0a0a" width="1920" height="1080" />
        <Label
            id="titleLabel"
            text="Who's watching?"
            font="font:LargeBoldSystemFont"
            color="#ffffff"
            horizAlign="center"
            width="1920"
            translation="[0, 200]" />
        <LabelList
            id="profileList"
            translation="[560, 320]"
            itemSize="[800, 80]"
            numRows="10"
            drawFocusFeedback="true" />
        <Label
            id="loadingLabel"
            text="Loading profiles..."
            font="font:MediumSystemFont"
            color="#888888"
            horizAlign="center"
            width="1920"
            translation="[0, 320]" />
    </children>
</component>
