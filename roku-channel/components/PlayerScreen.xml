<?xml version="1.0" encoding="utf-8"?>
<component name="PlayerScreen" extends="Group">
    <interface>
        <field id="api" type="assocarray" />
        <field id="mediaItemId" type="string" />
        <field id="episodeId" type="string" />
        <field id="contentTitle" type="string" />
        <field id="close" type="boolean" alwaysNotify="true" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />
    <children>
        <Rectangle color="#000000" width="1920" height="1080" />

        <Video
            id="videoPlayer"
            width="1920"
            height="1080"
            translation="[0, 0]"
            enableUI="true"
            enableTrickPlay="true" />

        <BusySpinner
            id="spinner"
            translation="[940, 520]"
            clockwise="true"
            visible="false" />

        <Label
            id="statusLabel"
            text=""
            font="font:MediumSystemFont"
            color="#ffffff"
            horizAlign="center"
            width="1920"
            translation="[0, 600]"
            visible="false" />

        <Label
            id="errorLabel"
            text=""
            font="font:MediumSystemFont"
            color="#cc4444"
            width="1200"
            horizAlign="center"
            translation="[360, 500]"
            visible="false" />
    </children>
</component>
