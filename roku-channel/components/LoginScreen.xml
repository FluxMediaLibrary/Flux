<?xml version="1.0" encoding="utf-8"?>
<component name="LoginScreen" extends="Group">
    <interface>
        <field id="api" type="assocarray" />
        <field id="close" type="boolean" alwaysNotify="true" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/LoginScreen.brs" />
    <children>
        <Rectangle
            id="background"
            color="#0a0a0a"
            width="1920" height="1080" />

        <Label
            id="titleLabel"
            text="Flux"
            font="font:LargeBoldSystemFont"
            horizAlign="center"
            width="1920"
            color="#ffffff"
            translation="[0, 140]" />

        <Label
            id="subtitleLabel"
            text="Sign in to your media library"
            font="font:MediumSystemFont"
            color="#888888"
            horizAlign="center"
            width="1920"
            translation="[0, 220]" />

        <!-- Email field -->
        <Label
            id="emailFieldLabel"
            text="Email"
            font="font:SmallBoldSystemFont"
            color="#999999"
            translation="[560, 360]" />
        <Rectangle
            id="emailFieldBg"
            color="#1a1a1a"
            width="800" height="60"
            translation="[560, 390]" />
        <Label
            id="emailField"
            text="Enter your email..."
            font="font:MediumSystemFont"
            color="#555555"
            width="760" height="60"
            translation="[580, 400]"
            ellipsizeOnBoundary="true" />

        <!-- Password field -->
        <Label
            id="passwordFieldLabel"
            text="Password"
            font="font:SmallBoldSystemFont"
            color="#999999"
            translation="[560, 500]" />
        <Rectangle
            id="passwordFieldBg"
            color="#1a1a1a"
            width="800" height="60"
            translation="[560, 530]" />
        <Label
            id="passwordField"
            text="Enter your password..."
            font="font:MediumSystemFont"
            color="#555555"
            width="760" height="60"
            translation="[580, 540]"
            ellipsizeOnBoundary="true" />

        <!-- Login button -->
        <Button
            id="loginButton"
            text="Log In"
            translation="[560, 640]"
            minWidth="800" />

        <BusySpinner
            id="spinner"
            translation="[940, 640]"
            visible="false"
            clockwise="true" />

        <Label
            id="errorLabel"
            text=""
            font="font:SmallSystemFont"
            color="#cc4444"
            width="800"
            translation="[560, 730]"
            visible="false"
            horizAlign="center" />
    </children>
</component>
