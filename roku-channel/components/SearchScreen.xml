<?xml version="1.0" encoding="utf-8"?>
<component name="SearchScreen" extends="Group">
    <interface>
        <field id="api" type="assocarray" />
        <field id="close" type="boolean" alwaysNotify="true" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />
    <children>
        <Rectangle color="#0a0a0a" width="1920" height="1080" />

        <Label
            id="titleLabel"
            text="Search"
            font="font:LargeBoldSystemFont"
            color="#ffffff"
            translation="[60, 40]" />

        <!-- Search bar -->
        <Rectangle
            id="searchBarBg"
            color="#1a1a1a"
            width="800" height="60"
            translation="[60, 110]" />
        <Label
            id="searchBarText"
            text="Press OK to search..."
            font="font:MediumSystemFont"
            color="#555555"
            width="760"
            translation="[80, 125]"
            ellipsizeOnBoundary="true" />

        <!-- Type tabs -->
        <Label
            id="tabAll"
            text="All"
            font="font:MediumBoldSystemFont"
            color="#00cc66"
            translation="[920, 115]" />
        <Label
            id="tabMovies"
            text="Movies"
            font="font:MediumSystemFont"
            color="#666666"
            translation="[990, 116]" />
        <Label
            id="tabShows"
            text="TV Shows"
            font="font:MediumSystemFont"
            color="#666666"
            translation="[1100, 116]" />

        <PosterGrid
            id="resultGrid"
            translation="[60, 210]"
            itemComponentName="LibraryGridItem"
            numColumns="5"
            numRows="2"
            itemSize="[340, 520]"
            itemSpacing="[20, 20]"
            drawFocusFeedback="true"
            visible="false" />

        <BusySpinner
            id="spinner"
            translation="[940, 500]"
            clockwise="true"
            visible="false" />

        <Label
            id="emptyLabel"
            text="No results found."
            font="font:MediumSystemFont"
            color="#888888"
            horizAlign="center"
            width="1920"
            translation="[0, 500]"
            visible="false" />

        <Label
            id="errorLabel"
            text=""
            font="font:MediumSystemFont"
            color="#cc4444"
            width="1200"
            horizAlign="center"
            translation="[360, 500]"
            visible="false" />
    </children>
</component>
