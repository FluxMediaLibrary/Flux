# Flux Roku Channel Manifest
# Development Application Installer: zip this directory and sideload

title=Flux
subtitle=Self-hosted media library
major_version=1
minor_version=0
build_version=0

# Channel configuration
splash_screen_fhd=images/splash-fhd.png
splash_screen_hd=images/splash-hd.png
splash_screen_sd=images/splash-sd.png
splash_color=#0a0a0a
splash_min_time=0

# Resolution support
ui_resolutions=fhd,hd

# Screen size support
bs_libs_required=roku_ads_lib

# Required features for streaming
requires_audiodecoder_wma
requires_audiodecoder_aac
requires_audiodecoder_mp3
requires_audiodecoder_ac3
requires_audiodecoder_eac3
requires_audiodecoder_dts
requires_audiodecoder_flac
requires_audiodecoder_vorbis

# Video codec support
supports_input_launch
