# ─── Flux environment (copy to .env and fill in) ──────────────────────────────

# Postgres
POSTGRES_USER=flux
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=flux
# Backend connects to the compose service host "postgres"
DATABASE_URL=postgresql://flux:change-me-strong-password@postgres:5432/flux?schema=public

# Redis (BullMQ job queue)
REDIS_URL=redis://redis:6379

# Auth — MUST be a long random secret in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# TMDb — get a key at https://www.themoviedb.org/settings/api (v3 API key)
TMDB_API_KEY=

# Backend
BACKEND_PORT=6948
# Public origin of the frontend, used for CORS + invite links
FRONTEND_ORIGIN=http://localhost:4938
# Public backend origin reachable by Chromecast/Smart TVs. Use HTTPS in production.
PUBLIC_API_BASE_URL=http://YOUR-LAN-IP-OR-DOMAIN:6948

# Media storage (host paths bind-mounted into the backend container)
# MEDIA_ROOTS takes priority; MEDIA_ROOT is for backward compat.
# Multiple roots: MEDIA_ROOTS=/data/media,/data/extra
MEDIA_ROOTS=
MEDIA_ROOT=/data/media          # organized library lives here (/data/media/movies, /data/media/tv)
# Spillover threshold: when a root drops below this many free bytes, new files
# go to the next root instead. Default 10 GB.
# MEDIA_SPILLOVER_THRESHOLD_BYTES=10737418240
DOWNLOAD_ROOT=/data/downloads   # torrent staging; production compose mounts this on /storage/flux-downloads
TRANSCODE_ROOT=/data/transcode  # ephemeral HLS segment output per stream session
CAST_SESSION_TTL_SECONDS=7200
FLUX_SERVER_NAME=Flux
FLUX_SERVER_VERSION=0.1.0

# Torrents
# TORRENT_POLL_INTERVAL_MS=15000 # background sweep interval for finished downloads (default 15s)
TRANSMISSION_RPC_URL=http://localhost:9091/transmission/rpc
TRANSMISSION_USER=admin
TRANSMISSION_PASS=flux

# Frontend
FRONTEND_PORT=4938
# Leave empty when the frontend and backend are served from the same public
# origin. Set only for split-domain deployments, then rebuild the frontend image
# because this value is baked into the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:6948
# Runtime-only backend origin used by the frontend container's same-origin /api
# proxy. Public image deployments normally keep this on localhost because both
# app containers use host networking in docker-compose.images.yml.
FLUX_INTERNAL_API_BASE_URL=http://127.0.0.1:6948

# First-run bootstrap admin (used to seed the initial ADMIN account if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
